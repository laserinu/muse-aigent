    function _slice(uint256 n) internal view returns (address[] memory, uint256[] memory) {
        address[] memory a = new address[](n);
        uint256[] memory m = new uint256[](n);
        for (uint256 i; i < n; ++i) { a[i] = addrs[i]; m[i] = amts[i]; }
        return (a, m);
    }

    function testGasFull1850() public {
        uint256 before = gasleft();
        disperse.disperse(address(token), addrs, amts);
        emit log_named_uint("gas_full_1850", before - gasleft());
    }

    function testGas500() public {
        (address[] memory a, uint256[] memory m) = _slice(500);
        uint256 before = gasleft();
        disperse.disperse(address(token), a, m);
        emit log_named_uint("gas_500", before - gasleft());
    }

